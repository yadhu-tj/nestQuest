# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nestquest

# JWT
JWT_SECRET_KEY=__SET_JWT_SECRET_IN_ENV__
SECRET_KEY=__SET_SECRET_KEY_IN_ENV__

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ChromaDB
CHROMA_PERSIST_PATH=./chroma_store

# File uploads
UPLOAD_FOLDER=./static/uploads/properties

# Admin seeding (optional, for initial setup)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
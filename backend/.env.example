# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nestquest

# JWT
JWT_SECRET_KEY=__SET_JWT_SECRET_IN_ENV__
JWT_REFRESH_SECRET_KEY=__SET_JWT_REFRESH_SECRET_IN_ENV__
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
SECRET_KEY=__SET_SECRET_KEY_IN_ENV__

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ChromaDB
CHROMA_PERSIST_PATH=./chroma_store

# File uploads
UPLOAD_FOLDER=./static/uploads/properties

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:5173

# Rate limiting storage (use Redis URL in production: redis://localhost:6379/0)
RATE_LIMIT_STORAGE_URL=memory://

# Admin seeding (optional, for initial setup)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Test environment (required for test_rag_pipeline.py)
NESTQUEST_TEST_USER_EMAIL=ragtest_user@nestquest.local
NESTQUEST_TEST_USER_PASSWORD=
NESTQUEST_TEST_USER_PHONE=9999999999
NESTQUEST_ADMIN_EMAIL=
NESTQUEST_ADMIN_PASSWORD=